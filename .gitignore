.venv/
__pycache__/
*.pyc
.DS_Store

# Evaluation artefacts. `results/*/` ignores generated subdirectories while
# keeping the research ledger and its head anchor -- which live directly in
# results/ -- under version control, because the ledger IS the audit trail.
results/*/
results/_unlocks/

# Raw vendor snapshots: large, and reproducible from the manifest.
#
# ANCHORED with a leading slash. A bare `data/` also matches `apex/data/`, and
# it silently excluded the ENTIRE data-adapter package -- base, synthetic,
# sharadar, identity, crosscheck -- from every commit up to b15b410. A clean
# clone could not import apex.data at all. Do not un-anchor this.
/data/

# Never commit a credential.
.env
*.key
logs/
data/live/
# ...except the live paper track: its chained ledger IS an audit trail.
!results/paper/
!results/reality/
.env.*
secrets/*

# unrelated tool state; churns constantly and would keep HASH_LINEAGE dirty
.claude-flow/

# generated daily-closes cache; a DECISION_SEMANTIC_INPUT whose
# identity is sealed per-tick as universe_provenance, not versioned here
exports/
