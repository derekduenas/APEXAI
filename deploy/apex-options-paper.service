[Unit]
Description=APEX options live PAPER_EXPLORATORY session
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=apex
Group=apex
WorkingDirectory=/opt/apex/current

Environment=PYTHONUNBUFFERED=1
Environment=APEX_SECRETS_DIR=/home/apex/.apex-secrets
Environment=APEX_HEARTBEAT_DIR=/apex-data/core/heartbeats
Environment=APEX_RELEASE_ROOT=/opt/apex
Environment=APEX_CANONICAL_REPO=/opt/apex-repo

ExecStart=/bin/sh -c '/opt/apex/shared/venv/bin/python -u \
    /opt/apex/current/scripts/options_paper_session.py \
    --ledger /apex-data/core/options_live_ledger.jsonl \
    --out /apex-data/history-a/paper_$(date +%%F).json \
    --minutes 390 --interval-min 15'

# A session that ends normally at the close is NOT a failure.
Restart=on-failure
RestartSec=60
StartLimitBurst=3
StartLimitIntervalSec=600

StandardOutput=append:/apex-data/core/logs/options-paper.log
StandardError=append:/apex-data/core/logs/options-paper.log

NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
